#version 430

// ---------------
// THREAD GROUP
// ---------------
layout(local_size_x = 16, local_size_y = 16) in;

// ---------------------
// ACCUMULATION IMAGE
// ---------------------
layout(rgba32f, binding = 0) coherent uniform image2D imgAccum;
layout(rgba32f, binding = 4) uniform writeonly image2D imgGbuffer;

// ---------
// TYPES
// --------
struct Sphere {
    vec4 centerRadius;

    vec3 diffuse;   float kd;
    vec3 specular;  float ks;
    float shininess;
    float pad1, pad2, pad3;
    int Material_type, pad4, pad5, pad6;
};

struct Square {
    vec4 a;
    vec4 b;
    vec4 c;
    vec4 d;

    vec3 diffuse;   float kd;
    vec3 specular;  float ks;
    float shininess;
    float pad1, pad2, pad3;
    int Material_type, pad4, pad5, pad6;
};

struct Mesh {
    int Material_type;
    int triOffset;
    int triCount;
    int pad0;
};

struct BVHNode {
    float minX, minY, minZ;
    int rightChildOrPrim;
    float maxX, maxY, maxZ;
    int triangleCount;
};

struct TriangleIndexed {
    uint v0, v1, v2, matIdx;
};

struct Vertex {
    vec4 pos; // xyz, pad
    vec4 normal; // xyz, pad
};

struct Material {
    vec3 diffuse; float kd;
    vec3 specular; float ks;
    float shininess; float pad1, pad2;
    int type; int pad4, pad5, pad6;
};

struct Light {
    vec4 posIntensity;
    vec4 color;
    float lightRadius, pad1, pad2, pad3;
};

// --------
// SSBO
// --------
layout(std430, binding = 1) buffer Spheres { Sphere spheres[]; };
layout(std430, binding = 2) buffer Lights  { Light  lights[];  };
layout(std430, binding = 3) buffer Squares { Square squares[]; };
layout(std430, binding = 4) buffer Meshes { Mesh meshes[]; };
layout(std430, binding = 5) buffer Triangles { TriangleIndexed triangles[]; };
layout(std430, binding = 6) buffer BVHNodes { BVHNode nodes[]; };
layout(std430, binding = 7) buffer Vertices { Vertex vertices[]; };
layout(std430, binding = 8) buffer Materials { Material materials[]; };

// -----------
// UNIFORMS
// -----------
layout(location = 0) uniform int u_sphereCount;
layout(location = 1) uniform int u_lightCount;
layout(location = 2) uniform vec3 u_camPos;
layout(location = 3) uniform vec3 u_camFront;
layout(location = 4) uniform vec3 u_camRight;
layout(location = 5) uniform vec3 u_camUp;
layout(location = 6) uniform float u_fovDeg;
layout(location = 7) uniform int u_width;
layout(location = 8) uniform int u_height;
layout(location = 9) uniform int u_squareCount;
layout(location = 10) uniform int u_frameIndex;
layout(location = 11) uniform int u_spp;
layout(location = 12) uniform int u_triangleCount;
layout(location = 13) uniform int u_meshCount;

// -------
// ALEA
// -------
uint hash_u(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float randf(inout uint state)
{
    state = hash_u(state);
    return float(state) / 4294967296.0;
}

// -----------------------
// hemisphere sampling
// -----------------------

vec3 randomHemisphere(vec3 N, inout uint seed)
{
    float u = randf(seed);
    float v = randf(seed);

    float phi = 2.0 * 3.14159265358979323846 * u;

    float cosTheta = sqrt(v);
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

    vec3 T = normalize(abs(N.x) > 0.1 ? cross(N, vec3(0,1,0)) : cross(N, vec3(1,0,0)));
    vec3 B = cross(N, T);

    return normalize(
        T * (cos(phi) * sinTheta) +
        B * (sin(phi) * sinTheta) +
        N * cosTheta
    );
}

vec3 sampleUniformSphere(inout uint seed)
{
    float u = randf(seed);
    float v = randf(seed);
    float z = 1.0 - 2.0 * u;
    float phi = 2.0 * 3.14159265358979323846 * v;
    float r = sqrt(max(0.0, 1.0 - z * z));
    return vec3(r * cos(phi), r * sin(phi), z);
}

// -------------
// HIT STRUCT
// -------------

struct Hit {
    float t;
    vec3 pos;
    vec3 normal;

    vec3 diffuse;
    float kd;

    vec3 specular;
    float ks;

    float shininess;
    int Material_type;
};

// ---------------
// INTERSECTIONS
// ---------------
bool intersectSphere(vec3 ro, vec3 rd, vec4 cR, out float t)
{
    vec3 oc = ro - cR.xyz;
    float r = cR.w;
    float b = dot(oc, rd);
    float c = dot(oc, oc) - r*r;
    float disc = b*b - c;
    if (disc < 0.0) return false;

    float sq = sqrt(disc);
    float t1 = -b - sq;
    float t2 = -b + sq;

    t = (t1 > 1e-4) ? t1 : ((t2 > 1e-4) ? t2 : -1.0);
    return t > 0.0;
}

bool intersectQuad(vec3 ro, vec3 rd, Square sq,
                   out float tHit, out vec3 normalOut, out vec3 diffuse, out vec3 specular, out float kd,out float ks,out float shininess)
{
    vec3 A = sq.a.xyz;
    vec3 B = sq.b.xyz;
    vec3 C = sq.c.xyz;
    vec3 D = sq.d.xyz;

    vec3 N = normalize(cross(B - A, D - A));
    float denom = dot(N, rd);
    if (abs(denom) < 1e-6) return false;

    float t = dot(A - ro, N) / denom;
    if (t <= 1e-4) return false;

    vec3 P = ro + rd * t;

    vec3 c1 = cross(B - A, P - A);
    vec3 c2 = cross(C - B, P - B);
    vec3 c3 = cross(A - C, P - C);

    if (dot(c1,N) >= 0.0 && dot(c2,N) >= 0.0 && dot(c3,N) >= 0.0) {
        tHit = t; normalOut = N; diffuse = sq.diffuse;
        specular=sq.specular;
        kd=sq.kd;
        ks=sq.ks;
        shininess=sq.shininess;
        return true;
    }

    vec3 c4 = cross(C - A, P - A);
    vec3 c5 = cross(D - C, P - C);
    vec3 c6 = cross(A - D, P - D);

    if (dot(c4,N) >= 0.0 && dot(c5,N) >= 0.0 && dot(c6,N) >= 0.0) {
        tHit = t;
        normalOut = N;
        diffuse = sq.diffuse;
        specular=sq.specular;
        kd=sq.kd;
        ks=sq.ks;
        shininess=sq.shininess;

        return true;
    }

    return false;
}

// ---------
// Intersection des triangles
// ---------

bool intersectTri(vec3 ro, vec3 rd, TriangleIndexed tri,
                    out float tHit, out vec3 normalOut, out vec3 diffuse, out vec3 specular, out float kd,out float ks,out float shininess, out int matType){

    vec3 v0 = vertices[tri.v0].pos.xyz;
    vec3 v1 = vertices[tri.v1].pos.xyz;
    vec3 v2 = vertices[tri.v2].pos.xyz;

    vec3 e1 = v1 - v0;
    vec3 e2 = v2 - v0;

    vec3 pvec = cross(rd, e2);
    float det = dot(e1, pvec);
    float detInv = 1.0/det;

    if (abs(det) < 1e-6) return false;

    vec3 tvec = ro - v0;
    float u = dot(tvec, pvec) * detInv;
    if (u < 0.0 || u > 1.0) return false;

    vec3 qvec = cross(tvec, e1);
    float v = dot(rd, qvec) * detInv;
    if (v < 0.0 || u + v > 1.0) return false;

    float t = dot(e2, qvec) * detInv;
    if (t <= 1e-4) return false;

    tHit = t;

    normalOut = normalize(cross(e1, e2));

    Material mat = materials[tri.matIdx];
    diffuse = mat.diffuse;
    specular = mat.specular;
    kd = mat.kd;
    ks = mat.ks;
    shininess = mat.shininess;
    matType = mat.type;

    return true;
}

// ---------
// AABB Intersection
// ---------

bool intersectAABB(vec3 ro, vec3 invRd, vec3 aabbMin, vec3 aabbMax, float tMin, float tMax) {
    vec3 t0 = (aabbMin - ro) * invRd;
    vec3 t1 = (aabbMax - ro) * invRd;

    vec3 tPetit = min(t0, t1);
    vec3 tGros  = max(t0, t1);

    float tmin = max(tMin, max(tPetit.x, max(tPetit.y, tPetit.z)));
    float tmax = min(tMax, min(tGros.x, min(tGros.y, tGros.z)));

    return tmin <= tmax;
}

// -------
// OMBRE
// -------

bool traceShadow(vec3 ro, vec3 rd, float maxDist)
{
    for (int i = 0; i < u_sphereCount; ++i)
    {
        float t;
        if (intersectSphere(ro, rd, spheres[i].centerRadius, t)) {
            if (t < maxDist) return true;
        }
    }

    for (int i = 0; i < u_squareCount; ++i)
    {
        vec3 A = squares[i].a.xyz;
        vec3 B = squares[i].b.xyz;
        vec3 D = squares[i].d.xyz;
        vec3 N = normalize(cross(B - A, D - A));
        float denom = dot(N, rd);
        if (abs(denom) > 1e-6) {
            float t = dot(A - ro, N) / denom;
            if (t > 1e-4 && t < maxDist) {
                vec3 P = ro + rd * t;
                vec3 C = squares[i].c.xyz;
                if (dot(cross(B - A, P - A), N) >= 0.0 &&
                    dot(cross(C - B, P - B), N) >= 0.0 &&
                    dot(cross(A - C, P - C), N) >= 0.0) return true;

                if (dot(cross(C - A, P - A), N) >= 0.0 &&
                    dot(cross(D - C, P - C), N) >= 0.0 &&
                    dot(cross(A - D, P - D), N) >= 0.0) return true;
            }
        }
    }

    if (u_triangleCount > 0) {
        vec3 invRd = 1.0 / rd;
        int stack[32];
        int stackPtr = 0;
        stack[stackPtr++] = 0; // Push root

        while (stackPtr > 0) {
            int nodeIdx = stack[--stackPtr];
            BVHNode node = nodes[nodeIdx];

            if (!intersectAABB(ro, invRd, vec3(node.minX, node.minY, node.minZ),
                                          vec3(node.maxX, node.maxY, node.maxZ), 1e-4, maxDist)) {
                continue;
            }

            if (node.triangleCount > 0) {
                for (int i = 0; i < node.triangleCount; ++i) {
                    int triIdx = node.rightChildOrPrim + i;
                    TriangleIndexed tri = triangles[triIdx];

                    vec3 v0 = vertices[tri.v0].pos.xyz;
                    vec3 v1 = vertices[tri.v1].pos.xyz;
                    vec3 v2 = vertices[tri.v2].pos.xyz;

                    vec3 e1 = v1 - v0;
                    vec3 e2 = v2 - v0;
                    vec3 pvec = cross(rd, e2);
                    float det = dot(e1, pvec);
                    float detInv = 1.0/det;

                    if (abs(det) > 1e-6) {
                        vec3 tvec = ro - v0;
                        float u = dot(tvec, pvec) * detInv;
                        if (u >= 0.0 && u <= 1.0) {
                            vec3 qvec = cross(tvec, e1);
                            float v = dot(rd, qvec) * detInv;
                            if (v >= 0.0 && u + v <= 1.0) {
                                float t = dot(e2, qvec) * detInv;
                                if (t > 1e-4 && t < maxDist) return true; // Early exit
                            }
                        }
                    }
                }
            } else {
                int leftChild = nodeIdx + 1;
                int rightChild = node.rightChildOrPrim;
                stack[stackPtr++] = rightChild;
                stack[stackPtr++] = leftChild;
            }
        }
    }

    return false;
}

// ---------
// TRACE
// ---------

bool trace(vec3 ro, vec3 rd, out Hit hit)
{
    hit.t = 1e30;
    bool found = false;

    // Spheres
    for (int i = 0; i < u_sphereCount; ++i)
    {
        float t;
        if (intersectSphere(ro, rd, spheres[i].centerRadius, t)) {
            if (t < hit.t) {
                hit.t = t;
                hit.pos = ro + rd * t;
                hit.normal = normalize(hit.pos - spheres[i].centerRadius.xyz);

                hit.diffuse = spheres[i].diffuse;
                hit.kd = spheres[i].kd;
                hit.specular = spheres[i].specular;
                hit.ks = spheres[i].ks;
                hit.shininess = spheres[i].shininess;
                hit.Material_type = spheres[i].Material_type;

                found = true;
            }
        }

    }

    // Squares
    for (int i = 0; i < u_squareCount; ++i)
    {
        float t; vec3 n; vec3 diffuse;
        float kd; float ks; float shininess;
        vec3 specular;
        if (intersectQuad(ro, rd, squares[i], t, n, diffuse,specular,kd,ks,shininess))
        {
            if (t < hit.t) {
                hit.t = t;
                hit.pos = ro + rd * t;
                hit.normal = n;
                hit.diffuse = diffuse;
                hit.specular=specular;
                hit.kd=kd;
                hit.ks=ks;
                hit.shininess=shininess;
                hit.Material_type = squares[i].Material_type;
                found = true;
            }
        }
    }

    // BVH
    if (u_triangleCount > 0) {
        vec3 invRd = 1.0 / rd;
        int stack[32];
        int stackPtr = 0;
        stack[stackPtr++] = 0;

        while (stackPtr > 0) {
            int nodeIdx = stack[--stackPtr];
            BVHNode node = nodes[nodeIdx];

            if (!intersectAABB(ro, invRd, vec3(node.minX, node.minY, node.minZ),
                                          vec3(node.maxX, node.maxY, node.maxZ), 0.001, hit.t)) {
                continue;
            }

            if (node.triangleCount > 0) {
                for (int i = 0; i < node.triangleCount; ++i) {
                    int triIdx = node.rightChildOrPrim + i;
                    float t; vec3 n; vec3 diffuse;
                    float kd; float ks; float shininess;
                    vec3 specular;
                    int matType;

                    if (intersectTri(ro, rd, triangles[triIdx], t, n, diffuse, specular, kd, ks, shininess, matType)) {
                        if (t < hit.t) {
                            hit.t = t;
                            hit.pos = ro + rd * t;
                            hit.normal = n;
                            hit.diffuse = diffuse;
                            hit.kd = kd;
                            hit.specular = specular;
                            hit.ks = ks;
                            hit.shininess = shininess;
                            hit.Material_type = matType;
                            found = true;
                        }
                    }
                }
            } else {
                int leftChild = nodeIdx + 1;
                int rightChild = node.rightChildOrPrim;

                stack[stackPtr++] = rightChild;
                stack[stackPtr++] = leftChild;
            }
        }
    }

    return found;
}

// ------
// MATERIALS
// ------

void mirror(in Hit h, inout vec3 ro, inout vec3 rd, inout vec3 throughput) {
    rd = reflect(rd, h.normal);
    ro = h.pos + h.normal * 1e-3;
    throughput *= vec3(1.0);
}

void glass(in Hit h, inout vec3 ro, inout vec3 rd, inout vec3 throughput) {
    float n1 = 1.0;
    float n2 = 1.5;
    float eta = n1 / n2;

    vec3 I = normalize(rd);
    vec3 N = h.normal;
    float cosi = clamp(dot(I, N), -1.0, 1.0);

    if (cosi > 0.0) {
        N = -N;
        float tmp = n1; n1 = n2; n2 = tmp;
        eta = n1 / n2;
        cosi = -cosi;
    }

    float k = 1.0 - eta * eta * (1.0 - cosi * cosi);

    if (k < 0.0) rd = reflect(I, N);
    else rd = eta * I - (eta * cosi + sqrt(k)) * N;

    ro = h.pos + N * 1e-3;
    throughput *= vec3(1.0);
}

// ------
// MAIN
// ------

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= u_width || px.y >= u_height) return;

    uint seed = uint(px.x) + uint(px.y) * 1664525u + uint(u_frameIndex) * 1013904223u;
    vec3 finalRadiance = vec3(0.0);

    for (int s = 0; s < u_spp; s++)
    {
        uint sseed = hash_u(seed + uint(s));
        float jx = randf(sseed);
        float jy = randf(sseed);

        vec2 uv = ((vec2(px) + vec2(jx, jy)) / vec2(u_width, u_height)) * 2.0 - 1.0;

        float fov = radians(u_fovDeg);
        float aspect = float(u_width) / float(u_height);
        float sx = uv.x * aspect * tan(fov * 0.5);
        float sy = uv.y * tan(fov * 0.5);

        vec3 ro = u_camPos;
        vec3 rd = normalize(u_camRight * sx + u_camUp * sy + u_camFront);

        vec3 throughput = vec3(1.0);
        vec3 radiance = vec3(0.0);
        const int MAX_BOUNCES = 5;

        for (int bounce = 0; bounce < MAX_BOUNCES; bounce++)
        {
            Hit h;

            if (!trace(ro, rd, h))
            {
                radiance += throughput * vec3(0.2, 0.3, 0.7);

                if (bounce == 0) {
                    imageStore(imgGbuffer, px, vec4(0,0,0, 1000.0));
                }
                break;
            }

            if (bounce == 0) {
                imageStore(imgGbuffer, px, vec4(h.normal, h.t));
            }

            // --- Miroir ---
            if (h.Material_type == 1) {
                mirror(h, ro, rd, throughput);
                continue;
            }

            // --- Verre ---
            if (h.Material_type == 2) {
                glass(h, ro, rd, throughput);
                continue;
            }

            vec3 V = normalize(-rd);
            vec3 directLight = h.diffuse * 0.05;

            for (int li = 0; li < u_lightCount; li++)
            {
                vec3 Lpos = lights[li].posIntensity.xyz;
                float intensity = lights[li].posIntensity.w;
                vec3 lightColor = lights[li].color.rgb;
                float lightRadius = lights[li].lightRadius;

                vec3 accumContribution = vec3(0.0);
                int shadowSamples = 1;

                for (int s = 0; s < shadowSamples; s++)
                {
                    vec3 rnd = sampleUniformSphere(seed);
                    vec3 lightPoint = Lpos + rnd * lightRadius;

                    vec3 toLight = lightPoint - h.pos;
                    float distSample = length(toLight);
                    vec3 Ls = toLight / distSample;

                    bool hitSomething = traceShadow(h.pos + h.normal * 1e-3, Ls, distSample - 1e-3);
                    bool visible = !hitSomething;

                    if (visible)
                    {
                        float attenuation = 1.0 / (distSample * distSample);
                        float diff = max(dot(h.normal, Ls), 0.0);
                        vec3 diffuseTerm = h.kd * h.diffuse * diff;

                        vec3 R = reflect(-Ls, h.normal);
                        float spec = pow(max(dot(R, V), 0.0), h.shininess);
                        vec3 specTerm = h.ks * h.specular * spec;

                        accumContribution += (diffuseTerm + specTerm) * lightColor * intensity * attenuation;
                    }
                }

                directLight += accumContribution / float(shadowSamples);
            }

            radiance += throughput * directLight;
            throughput *= h.diffuse;

            if (bounce > 2)
            {
                float p = clamp(max(max(throughput.r, throughput.g), throughput.b), 0.05, 0.95);
                if (randf(sseed) > p) break;
                throughput /= p;
            }

            ro = h.pos + h.normal * 1e-3;
            rd = randomHemisphere(h.normal, sseed);
        }

        finalRadiance += radiance;
    }

    finalRadiance /= float(u_spp);
    finalRadiance = min(finalRadiance, vec3(10.0));

    imageStore(imgAccum, px, vec4(finalRadiance, 1.0));
}
