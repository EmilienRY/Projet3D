#version 430
#extension GL_ARB_bindless_texture : require
#extension GL_ARB_gpu_shader_int64 : require

layout(local_size_x = 16, local_size_y = 16) in;

// img accum
layout(rgba32f, binding = 0) coherent uniform image2D imgAccum;
layout(rgba32f, binding = 4) uniform writeonly image2D imgGbuffer;

// type
struct Sphere {
    vec4 centerRadius;

    vec3 diffuse;
    float kd;

    vec3 specular;
    float ks;

    float shininess;
    float emissionR, emissionG, emissionB;

    int materialType;
    int textureIdx;
    float emissionStrength;
    int normalMapIdx;

    float ior;
    float pad0;
    float pad1;
    float pad2;
};

struct Square {
    vec4 a;
    vec4 b;
    vec4 c;
    vec4 d;

    vec3 diffuse;
    float kd;

    vec3 specular;
    float ks;

    float shininess;
    float emissionR, emissionG, emissionB;

    int materialType;
    int textureIdx;
    float emissionStrength;
    int normalMapIdx;

    float ior;
    float pad0;
    float pad1;
    float pad2;
};

struct Mesh {
    int materialType;
    int triOffset;
    int triCount;
    int pad0;
};

struct BVHNode {
    float minX, minY, minZ;
    int rightChildOrPrim;
    float maxX, maxY, maxZ;
    int triangleCount;
};

struct TriangleIndexed {
    uint v0, v1, v2, matIdx;
};

struct Vertex {
    vec4 pos;    // xyz, pad
    vec4 normal; // xyz, pad
    vec4 uv;     // uv, pad, pad
};

struct Material {
    vec3 diffuse;
    float kd;

    vec3 specular;
    float ks;

    float shininess;
    float emissionStrength;
    int normalMapIdx;
    int type;

    int textureIdx;
    float emissionR, emissionG, emissionB;

    float ior;
    float pad0;
    float pad1;
    float pad2;
};

struct Light {
    vec4 posIntensity;
    vec4 color;
    float lightRadius;
    float pad1;
    float pad2;
    float pad3;
};

//SSBO
layout(std430, binding = 1) buffer Spheres { Sphere spheres[]; };
layout(std430, binding = 2) buffer Lights  { Light  lights[];  };
layout(std430, binding = 3) buffer Squares { Square squares[]; };
layout(std430, binding = 4) buffer Meshes { Mesh meshes[]; };
layout(std430, binding = 5) buffer Triangles { TriangleIndexed triangles[]; };
layout(std430, binding = 6) buffer BVHNodes { BVHNode nodes[]; };
layout(std430, binding = 7) buffer Vertices { Vertex vertices[]; };
layout(std430, binding = 8) buffer Materials { Material materials[]; };
layout(std430, binding = 9) buffer TextureHandles { uint64_t handles[]; };

// uniform
layout(location = 0) uniform int u_sphereCount;
layout(location = 1) uniform int u_lightCount;
layout(location = 2) uniform vec3 u_camPos;
layout(location = 3) uniform vec3 u_camFront;
layout(location = 4) uniform vec3 u_camRight;
layout(location = 5) uniform vec3 u_camUp;
layout(location = 6) uniform int u_width;
layout(location = 7) uniform int u_height;
layout(location = 8) uniform int u_squareCount;
layout(location = 9) uniform int u_frameIndex;
layout(location = 10) uniform int u_nbRay;
layout(location = 11) uniform int u_triangleCount;
layout(location = 12) uniform int u_meshCount;
layout(location = 13) uniform int u_maxBounces;
layout(location = 14) uniform int u_shadowSamples;
layout(location = 15) uniform float u_lensRadius;
layout(location = 16) uniform float u_focalDistance;
layout(location = 17) uniform int u_enableDoF;
layout(location = 18) uniform vec3 u_bgColor;

// alea 

uint hash_u(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float randf(inout uint state)
{
    state = hash_u(state);
    return float(state) / 4294967296.0;
}

vec3 randomHemisphere(vec3 N, inout uint seed)
{
    float u = randf(seed);
    float v = randf(seed);

    float phi = 2.0 * 3.14159265358979323846 * u;

    float cosTheta = sqrt(v);
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

    vec3 T = normalize(abs(N.x) > 0.1 ? cross(N, vec3(0,1,0)) : cross(N, vec3(1,0,0)));
    vec3 B = cross(N, T);

    return normalize(
        T * (cos(phi) * sinTheta) +
        B * (sin(phi) * sinTheta) +
        N * cosTheta
    );
}

vec2 sampleDisk(vec2 u)
{
    float ox = 2.0 * u.x - 1.0;
    float oy = 2.0 * u.y - 1.0;
    if (ox == 0.0 && oy == 0.0) return vec2(0.0);
    float r, theta;
    if (abs(ox) > abs(oy)) {
        r = ox;
        theta = (3.14159265359 / 4.0) * (oy / ox);
    } else {
        r = oy;
        theta = (3.14159265359 / 2.0) - (3.14159265359 / 4.0) * (ox / oy);
    }
    return r * vec2(cos(theta), sin(theta));
}

// hit struct


struct Hit {
    float t;
    vec3 pos;
    vec3 normal;
    vec2 uv;
    vec3 tangent;

    vec3 diffuse;
    float kd;

    vec3 specular;
    float ks;

    float shininess;
    int materialType;
    int textureIdx;
    int normalMapIdx;

    vec3 emission;
    float emissionStrength;
    float ior;
};


// Intersections

bool intersectSphere(vec3 ro, vec3 rd, int i, inout Hit hit)
{
    vec4 cR = spheres[i].centerRadius;
    vec3 oc = ro - cR.xyz;
    float r = cR.w;
    float b = dot(oc, rd);
    float c = dot(oc, oc) - r*r;
    float disc = b*b - c;
    if (disc < 0.0) return false;

    float sq = sqrt(disc);
    float t1 = -b - sq;
    float t2 = -b + sq;

    float t = (t1 > 1e-4) ? t1 : ((t2 > 1e-4) ? t2 : -1.0);
    
    if (t > 0.0 && t < hit.t)
    {
        hit.t = t;
        hit.pos = ro + rd * t;
        hit.normal = normalize(hit.pos - cR.xyz);

        Sphere s = spheres[i];
        hit.diffuse = s.diffuse;
        hit.kd = s.kd;
        hit.specular = s.specular;
        hit.ks = s.ks;
        hit.shininess = s.shininess;
        hit.materialType = s.materialType;
        hit.textureIdx = s.textureIdx;
        hit.normalMapIdx = s.normalMapIdx;
        hit.emission = vec3(s.emissionR, s.emissionG, s.emissionB);
        hit.emissionStrength = s.emissionStrength;
        hit.ior = s.ior;

        vec3 N = hit.normal;
        float u = 0.5 + atan(N.z, N.x) / (2.0 * 3.14159265);
        float v = 0.5 + asin(N.y) / 3.14159265;
        hit.uv = vec2(u, v);
        
        hit.tangent = normalize(vec3(-N.z, 0.0, N.x));
        if (length(hit.tangent) < 0.001) hit.tangent = vec3(1,0,0);

        return true;
    }
    return false;
}

bool intersectQuad(vec3 ro, vec3 rd, int i, inout Hit hit) {

    Square sq = squares[i];
    vec3 A = sq.a.xyz;
    vec3 B = sq.b.xyz;
    vec3 C = sq.c.xyz;
    vec3 D = sq.d.xyz;

    vec3 N = normalize(cross(B - A, D - A));
    float denom = dot(N, rd);
    if (abs(denom) < 1e-6) return false;

    float t = dot(A - ro, N) / denom;
    if (t <= 1e-4 || t >= hit.t) return false;

    vec3 P = ro + rd * t;
    bool inside = false;
    vec2 uv = vec2(0.0);


    vec3 c1 = cross(B - A, P - A);
    vec3 c2 = cross(C - B, P - B);
    vec3 c3 = cross(A - C, P - C);

    if (dot(c1,N) >= 0.0 && dot(c2,N) >= 0.0 && dot(c3,N) >= 0.0) {
        inside = true;
        float areaABC = length(cross(B-A, C-A));
        float u_bary = length(c2) / areaABC;
        float v_bary = length(c3) / areaABC;
        float w_bary = length(c1) / areaABC;
        uv = u_bary*vec2(0,0) + v_bary*vec2(1,0) + w_bary*vec2(1,1);
    } 
    else {

        vec3 c4 = cross(C - A, P - A);
        vec3 c5 = cross(D - C, P - C);
        vec3 c6 = cross(A - D, P - D);

        if (dot(c4,N) >= 0.0 && dot(c5,N) >= 0.0 && dot(c6,N) >= 0.0) {
            inside = true;
            float areaACD = length(cross(C-A, D-A));
            float u_bary = length(c5) / areaACD;
            float v_bary = length(c6) / areaACD;
            float w_bary = length(c4) / areaACD;
            uv = u_bary*vec2(0,0) + v_bary*vec2(1,1) + w_bary*vec2(0,1);
        }
    }

    if (inside) {
        hit.t = t;
        hit.pos = P;
        hit.normal = N;
        hit.uv = uv;
        hit.tangent = normalize(B - A);
        
        hit.diffuse = sq.diffuse;
        hit.specular = sq.specular;
        hit.kd = sq.kd;
        hit.ks = sq.ks;
        hit.shininess = sq.shininess;
        hit.materialType = sq.materialType;
        hit.textureIdx = sq.textureIdx;
        hit.emission = vec3(sq.emissionR, sq.emissionG, sq.emissionB);
        hit.emissionStrength = sq.emissionStrength;
        hit.normalMapIdx = sq.normalMapIdx;
        hit.ior = sq.ior;
        
        return true;
    }

    return false;
}

bool intersectTri(vec3 ro, vec3 rd, int triIdx, inout Hit hit) {
    TriangleIndexed tri = triangles[triIdx];
    vec3 v0 = vertices[tri.v0].pos.xyz;
    vec3 v1 = vertices[tri.v1].pos.xyz;
    vec3 v2 = vertices[tri.v2].pos.xyz;

    vec3 e1 = v1 - v0;
    vec3 e2 = v2 - v0;

    vec3 pvec = cross(rd, e2);
    float det = dot(e1, pvec);
    float detInv = 1.0 / det;

    if (abs(det) < 1e-6) return false;

    vec3 tvec = ro - v0;
    float u = dot(tvec, pvec) * detInv;
    if (u < 0.0 || u > 1.0) return false;

    vec3 qvec = cross(tvec, e1);
    float v = dot(rd, qvec) * detInv;
    if (v < 0.0 || u + v > 1.0) return false;

    float t = dot(e2, qvec) * detInv;
    if (t <= 1e-4 || t >= hit.t) return false;

    hit.t = t;
    hit.pos = ro + rd * t;

    vec3 n0 = vertices[tri.v0].normal.xyz;
    vec3 n1 = vertices[tri.v1].normal.xyz;
    vec3 n2 = vertices[tri.v2].normal.xyz;
    hit.normal = normalize((1.0 - u - v) * n0 + u * n1 + v * n2);

    vec2 uv0 = vertices[tri.v0].uv.xy;
    vec2 uv1 = vertices[tri.v1].uv.xy;
    vec2 uv2 = vertices[tri.v2].uv.xy;
    hit.uv = (1.0 - u - v) * uv0 + u * uv1 + v * uv2;


    vec2 deltaUV1 = uv1 - uv0;
    vec2 deltaUV2 = uv2 - uv0;
    float f = 1.0 / (deltaUV1.x * deltaUV2.y - deltaUV2.x * deltaUV1.y);
    
    vec3 tangent = f * (deltaUV2.y * e1 - deltaUV1.y * e2);
    hit.tangent = normalize(tangent);


    Material mat = materials[tri.matIdx];
    hit.diffuse = mat.diffuse;
    hit.specular = mat.specular;
    hit.kd = mat.kd;
    hit.ks = mat.ks;
    hit.shininess = mat.shininess;
    hit.materialType = mat.type;
    hit.textureIdx = mat.textureIdx;
    hit.emission = vec3(mat.emissionR, mat.emissionG, mat.emissionB);
    hit.emissionStrength = mat.emissionStrength;
    hit.normalMapIdx = mat.normalMapIdx;
    hit.ior = mat.ior;


    return true;
}

bool intersectAABB(vec3 ro, vec3 invRd, vec3 aabbMin, vec3 aabbMax, float tMin, float tMax) {
    vec3 t0 = (aabbMin - ro) * invRd;
    vec3 t1 = (aabbMax - ro) * invRd;

    vec3 tPetit = min(t0, t1);
    vec3 tGros  = max(t0, t1);

    float tmin = max(tMin, max(tPetit.x, max(tPetit.y, tPetit.z)));
    float tmax = min(tMax, min(tGros.x, min(tGros.y, tGros.z)));

    return tmin <= tmax;
}


// test ombre
bool traceShadow(vec3 ro, vec3 rd, float maxDist) {


    // Spheres
    for (int i = 0; i < u_sphereCount; ++i) {
        vec4 cR = spheres[i].centerRadius;
        vec3 oc = ro - cR.xyz;
        float r = cR.w;
        float b = dot(oc, rd);
        float c = dot(oc, oc) - r*r;
        float disc = b*b - c;
        
        if (disc < 0.0) continue;
        float sq = sqrt(disc);
        float t1 = -b - sq;
        float t2 = -b + sq;
        float t = (t1 > 1e-4) ? t1 : ((t2 > 1e-4) ? t2 : -1.0);
        
        if (t > 0.0 && t < maxDist) {
            if (spheres[i].materialType == 2) continue;
            return true;
        }
    }

    // Squares
    for (int i = 0; i < u_squareCount; ++i) {
        vec3 A = squares[i].a.xyz;
        vec3 B = squares[i].b.xyz;
        vec3 D = squares[i].d.xyz;
        vec3 N = normalize(cross(B - A, D - A));
        float denom = dot(N, rd);
        
        if (abs(denom) < 1e-6) continue;

        float t = dot(A - ro, N) / denom;
        if (t <= 1e-4 || t >= maxDist) continue;

        vec3 P = ro + rd * t;
        vec3 C = squares[i].c.xyz;
        
        bool hit = false;
        if (dot(cross(B - A, P - A), N) >= 0.0 &&
            dot(cross(C - B, P - B), N) >= 0.0 &&
            dot(cross(A - C, P - C), N) >= 0.0) hit = true;
        else if (dot(cross(C - A, P - A), N) >= 0.0 &&
                 dot(cross(D - C, P - C), N) >= 0.0 &&
                 dot(cross(A - D, P - D), N) >= 0.0) hit = true;

        if (hit) {
            if (squares[i].materialType == 2) continue;
            return true;
        }
    }

    // BVH
    if (u_triangleCount > 0) {
        vec3 invRd = 1.0 / rd;
        int stack[32];
        int stackPtr = 0;
        stack[stackPtr++] = 0;

        while (stackPtr > 0) {
            int nodeIdx = stack[--stackPtr];
            BVHNode node = nodes[nodeIdx];

            if (!intersectAABB(ro, invRd, vec3(node.minX, node.minY, node.minZ),
                                          vec3(node.maxX, node.maxY, node.maxZ), 1e-4, maxDist)) {
                continue;
            }

            if (node.triangleCount > 0) {
                for (int i = 0; i < node.triangleCount; ++i) {
                    int triIdx = node.rightChildOrPrim + i;
                    TriangleIndexed tri = triangles[triIdx];

                    vec3 v0 = vertices[tri.v0].pos.xyz;
                    vec3 v1 = vertices[tri.v1].pos.xyz;
                    vec3 v2 = vertices[tri.v2].pos.xyz;

                    vec3 e1 = v1 - v0;
                    vec3 e2 = v2 - v0;
                    vec3 pvec = cross(rd, e2);
                    float det = dot(e1, pvec);
                    float detInv = 1.0/det;

                    if (abs(det) < 1e-6) continue;

                    vec3 tvec = ro - v0;
                    float u = dot(tvec, pvec) * detInv;
                    if (u < 0.0 || u > 1.0) continue;

                    vec3 qvec = cross(tvec, e1);
                    float v = dot(rd, qvec) * detInv;
                    if (v < 0.0 || u + v > 1.0) continue;

                    float t = dot(e2, qvec) * detInv;
                    if (t > 1e-4 && t < maxDist) {
                        if (materials[tri.matIdx].type == 2) continue;
                        return true;
                    }
                }
            } else {
                int leftChild = nodeIdx + 1;
                int rightChild = node.rightChildOrPrim;
                stack[stackPtr++] = rightChild;
                stack[stackPtr++] = leftChild;
            }
        }
    }

    return false;
}

// test inter

bool trace(vec3 ro, vec3 rd, out Hit hit)
{
    hit.t = 1e30;
    hit.textureIdx = -1;
    hit.normalMapIdx = -1;
    hit.uv = vec2(0.0);
    bool found = false;

    // Spheres
    for (int i = 0; i < u_sphereCount; ++i)
    {
        if (intersectSphere(ro, rd, i, hit)) {
            found = true;
        }
    }

    // Squares
    for (int i = 0; i < u_squareCount; ++i)
    {
        if (intersectQuad(ro, rd, i, hit)) {
            found = true;
        }
    }

    // BVH
    if (u_triangleCount > 0) {
        vec3 invRd = 1.0 / rd;
        int stack[32];
        int stackPtr = 0;
        stack[stackPtr++] = 0;

        while (stackPtr > 0) {
            int nodeIdx = stack[--stackPtr];
            BVHNode node = nodes[nodeIdx];

            if (!intersectAABB(ro, invRd, vec3(node.minX, node.minY, node.minZ),
                                          vec3(node.maxX, node.maxY, node.maxZ), 0.001, hit.t)) {
                continue;
            }

            if (node.triangleCount > 0) {
                for (int i = 0; i < node.triangleCount; ++i) {
                    int triIdx = node.rightChildOrPrim + i;
                    if (intersectTri(ro, rd, triIdx, hit)) {
                        found = true;
                    }
                }
            } else {
                int leftChild = nodeIdx + 1;
                int rightChild = node.rightChildOrPrim;

                stack[stackPtr++] = rightChild;
                stack[stackPtr++] = leftChild;
            }
        }
    }

    return found;
}

//mat

void mirror(in Hit h, inout vec3 ro, inout vec3 rd, inout vec3 throughput) {
    rd = reflect(rd, h.normal);
    ro = h.pos + h.normal * 1e-3;
    throughput *= h.specular;
}

void glass(in Hit h, inout vec3 ro, inout vec3 rd, inout vec3 throughput, inout uint seed) {
    float n1 = 1.0;
    float n2 = h.ior;
    float eta = n1 / n2;

    vec3 I = normalize(rd);
    vec3 N = h.normal;
    float cosi = clamp(dot(I, N), -1.0, 1.0);

    if (cosi > 0.0) {
        N = -N;
        float tmp = n1; n1 = n2; n2 = tmp;
        eta = n1 / n2;
        cosi = -cosi;
    }

    float k = 1.0 - eta * eta * (1.0 - cosi * cosi);
    
    float r0 = (n1 - n2) / (n1 + n2);
    r0 = r0 * r0;
    float fresnel = r0 + (1.0 - r0) * pow(1.0 - abs(cosi), 5.0);

    if (k < 0.0 || randf(seed) < fresnel) {
        rd = reflect(I, N);
        ro = h.pos + N * 1e-3;
    }
    else {
        rd = eta * I - (eta * cosi + sqrt(k)) * N;
        ro = h.pos - N * 1e-3;
    }

    throughput *= vec3(1.0);
}


//MAIN

void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoords.x >= u_width || pixelCoords.y >= u_height) return;

    uint seed = uint(pixelCoords.x) + uint(pixelCoords.y) * 1664525u + uint(u_frameIndex) * 1013904223u;
    vec3 finalRadiance = vec3(0.0);

    for (int s = 0; s < u_nbRay; s++) {
        uint raySeed = hash_u(seed + uint(s));
        
        vec2 jitter = vec2(randf(raySeed), randf(raySeed));
        vec2 uv = ((vec2(pixelCoords) + jitter) / vec2(u_width, u_height)) * 2.0 - 1.0;

        float fov = radians(60.0f);
        float aspect = float(u_width) / float(u_height);
        float sx = uv.x * aspect * tan(fov * 0.5);
        float sy = uv.y * tan(fov * 0.5);

        vec3 ro = u_camPos;
        vec3 rd = normalize(u_camRight * sx + u_camUp * sy + u_camFront);

        if (u_enableDoF != 0 && u_lensRadius > 1e-6) {
            vec3 focalPoint = ro + rd * u_focalDistance;
            vec2 lensSample = sampleDisk(vec2(randf(raySeed), randf(raySeed))) * u_lensRadius;
            
            ro += u_camRight * lensSample.x + u_camUp * lensSample.y;
            rd = normalize(focalPoint - ro);
        }

        vec3 throughput = vec3(1.0);
        vec3 radiance = vec3(0.0);

        for (int bounce = 0; bounce < u_maxBounces; bounce++) {
            Hit hit;
            if (!trace(ro, rd, hit)) {
                radiance += throughput * u_bgColor;
                if (bounce == 0) imageStore(imgGbuffer, pixelCoords, vec4(0, 0, 0, 1000.0));
                break;
            }

            if (bounce == 0) {
                imageStore(imgGbuffer, pixelCoords, vec4(hit.normal, hit.t));
            }

            if (hit.normalMapIdx >= 0) {
                vec3 mapN = texture(sampler2D(handles[hit.normalMapIdx]), hit.uv).rgb * 2.0 - 1.0;
                vec3 T = normalize(hit.tangent - hit.normal * dot(hit.normal, hit.tangent));
                vec3 B = cross(hit.normal, T);
                hit.normal = normalize(mat3(T, B, hit.normal) * mapN);
            }

            radiance += throughput * hit.emission * hit.emissionStrength;

            if (hit.materialType == 1) { // mirroire
                mirror(hit, ro, rd, throughput);
                continue;
            }
            if (hit.materialType == 2) { // verre
                glass(hit, ro, rd, throughput, raySeed);
                continue;
            }

            vec3 V = normalize(-rd);
            vec3 albedo = hit.diffuse;
            if (hit.textureIdx >= 0) {
                albedo = texture(sampler2D(handles[hit.textureIdx]), hit.uv).rgb;
            }

            vec3 directLight = vec3(0.0);
            for (int i = 0; i < u_lightCount; i++) {
                Light light = lights[i];
                vec3 Lpos = light.posIntensity.xyz;
                float intensity = light.posIntensity.w;
                
                vec3 accumShadow = vec3(0.0);
                for (int sh = 0; sh < u_shadowSamples; sh++) {
                    vec2 rnd = vec2(randf(seed), randf(seed));
                    vec2 diskPoint = sampleDisk(rnd) * light.lightRadius;
                    vec3 lightPoint = Lpos + vec3(diskPoint.x, 0.0, diskPoint.y);

                    vec3 toLight = lightPoint - hit.pos;
                    float dist = length(toLight);
                    vec3 L = toLight / dist;

                    if (!traceShadow(hit.pos + hit.normal * 1e-3, L, dist - 1e-3)) {
                        float atten = 1.0 / (dist * dist);
                        float diff = max(dot(hit.normal, L), 0.0);
                        
                        vec3 R = reflect(-L, hit.normal);
                        float spec = pow(max(dot(R, V), 0.0), hit.shininess);
                        
                        accumShadow += (hit.kd * albedo * diff + hit.ks * hit.specular * spec) 
                                     * light.color.rgb * intensity * atten;
                    }
                }
                directLight += accumShadow / float(u_shadowSamples);
            }

            radiance += throughput * directLight;
            throughput *= albedo;

            if (bounce > 2) {
                float p = clamp(max(max(throughput.r, throughput.g), throughput.b), 0.05, 0.95);
                if (randf(raySeed) > p) break;
                throughput /= p;
            }

            ro = hit.pos + hit.normal * 1e-3;
            rd = randomHemisphere(hit.normal, raySeed);
        }
        finalRadiance += radiance;
    }

    imageStore(imgAccum, pixelCoords, vec4(finalRadiance / float(u_nbRay), 1.0));
}
